# Dependencies
node_modules/
*/node_modules/

# Build outputs
out/
dist/
build/
target/
book/

# Generated WASM files
**/pkg/
*.wasm
*.wasm.d.ts
wasm.js
wasm.d.ts

# ...except the frontend's copy, which IS committed. app/src/app/lib/wasm.ts
# imports it directly, so without it `next build` fails on a fresh clone and on
# Vercel, which has no Rust toolchain. Regenerate after changing pdf-utils:
#   cd pdf-utils/wasm && wasm-pack build --target web --out-dir pkg
#   mkdir -p ../../app/public/pkg && cp -r pkg/* ../../app/public/pkg/
!app/public/pkg/
!app/public/pkg/**

