# Copy this file to .env and fill in real values.
# cp .env.example .env
# Loaded via dotenv::dotenv() in circuits/script/src/bin/prover.rs

# 'network' delegates proof generation to the Succinct Prover Network,
# 'local' generates proofs on this machine (slower, no key required).
SP1_PROVER=network

# Required when SP1_PROVER=network. Get one from https://network.succinct.xyz
# Must be a 0x-prefixed private key for an account funded on the network.
NETWORK_PRIVATE_KEY=0xyour_succinct_network_private_key

# Port the prover HTTP service (/prove, /verify) listens on.
PORT=3001

RUST_LOG=info
