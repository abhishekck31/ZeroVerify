# Copy this file to .env and fill in real values.
# cp .env.example .env
# Loaded via dotenv::dotenv() in circuits/script/src/bin/prover.rs

# Proving backend:
#   cpu      - prove on this machine. No account needed, but a Groth16 proof
#              takes minutes, wants plenty of RAM, and needs Docker running
#              for the Groth16 wrapper. This is the default.
#   network  - delegate to the Succinct Prover Network. Fast, but requires a
#              funded account and NETWORK_PRIVATE_KEY below.
#   mock     - returns proofs that are NOT cryptographically valid. Useful only
#              for exercising the plumbing.
SP1_PROVER=cpu

# Required only when SP1_PROVER=network. Get one from https://network.succinct.xyz
# Must be a 0x-prefixed private key for an account funded on the network.
# NETWORK_PRIVATE_KEY=0xyour_succinct_network_private_key

# Browser origins allowed to call /prove and /verify, comma separated.
# Leave unset to allow any origin (development only).
# ALLOWED_ORIGIN=https://your-app.vercel.app

# Port the prover HTTP service (/prove, /verify) listens on.
PORT=3001

RUST_LOG=info
