# Copy this file to .env.local and fill in real values.
# cp .env.example .env.local

# --- MongoDB ---
# Connection string for the verification data store.
# Read by app/src/utils/connectToDb.ts
MONGO_URL=mongodb://localhost:27017/zeroverify

# --- Outgoing email (Gmail SMTP) ---
# Used to send verification request/confirmation emails.
# Read by app/src/utils/mail/transporter.ts
# MAIL_PASS must be a Gmail "App Password", not your normal account password
# (requires 2FA enabled on the Google account): https://myaccount.google.com/apppasswords
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-gmail-app-password

# --- App URL ---
# Base URL used to build verification links inside emails.
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Clerk authentication ---
# Required — app/src/app/layout.tsx wraps the whole app in <ClerkProvider>.
# Get these from https://dashboard.clerk.com after creating an application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# --- Verification link tokens ---
# Signs the capability token in emailed verification links, so a candidate can
# open their request without holding an account on the exact address the
# employer typed. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates every link already sent.
ACCESS_TOKEN_SECRET=

# --- Prover service ---
# Base URL of the Rust/SP1 prover service (see circuits/.env.example).
# Currently hardcoded to http://localhost:3001 in the page components under
# app/src/app/{name,pan,academic}/[id]/page.tsx — set this and update those
# fetch() calls if you need a configurable endpoint.
NEXT_PUBLIC_PROVER_URL=http://localhost:3001
